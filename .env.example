# PayPal sandbox REST app (Developer Dashboard > Apps & Credentials > Sandbox).
# Leave empty to run with PayPal off: the policy engine and the proposed API
# still work, and every response says no PayPal call was made.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set to enable webhook signature verification.
PAYPAL_WEBHOOK_ID=

# Sandbox test card that plays the consumer's funding (generate one in the
# Developer Dashboard card generator). Sandbox only.
LUPA_TEST_CARD_NUMBER=
LUPA_TEST_CARD_EXPIRY=2030-12
LUPA_TEST_CARD_NAME=Test Buyer

# Any OpenAI-compatible chat endpoint. Leave empty to run without AI:
# the engine then treats every assessment as unavailable (fail closed).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_CALLS_PER_HOUR=60
LLM_MAX_CALLS_PER_DAY=500
LLM_DAILY_SPEND_CEILING=0
LLM_COST_PER_1M_INPUT=0
LLM_COST_PER_1M_OUTPUT=0

LUPA_DB=var/lupa.db
LUPA_HOLD_HOURS=72
