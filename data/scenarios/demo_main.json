{
 "description": "The video scenario (build spec 13). '@due' is the EUR recurring permission whose next charge is due now; amounts like 'median' or 'median*4.75' come from its profile, 'limit' rounds max x 1.15 up to whole 5s. Literal amounts are minor units.",
 "steps": [
  {
   "do": "policy",
   "permission": "@due",
   "policy": {
    "max_amount": "limit",
    "recurring": "allow"
   }
  },
  {
   "do": "request",
   "permission": "@due",
   "amount": "median",
   "is_recurring": true,
   "expect": "ALLOW",
   "save_as": "normal",
   "say": "The usual charge, on schedule: within the limit"
  },
  {
   "do": "request",
   "permission": "@due",
   "amount": "median*4.75",
   "is_recurring": true,
   "expect": "HOLD",
   "save_as": "big",
   "say": "Nearly five times the usual: above the limit"
  },
  {
   "do": "resolve",
   "request": "big",
   "action": "approve",
   "expect": "captured",
   "say": "You approve it: captured"
  },
  {
   "do": "request",
   "permission": "@due",
   "amount": 1200,
   "merchant_alias": "New Merchant",
   "expect": "HOLD",
   "say": "A different merchant on this permission"
  },
  {
   "do": "agent_permission",
   "agent_id": "shopping-agent",
   "label": "Shopping",
   "save_as": "agent",
   "policy": {
    "max_amount": 10000,
    "recurring": "block",
    "new_merchant": "allow"
   },
   "delegation": {
    "authority": "approve",
    "max_amount": 8000,
    "recurring_allowed": false,
    "days": 7
   }
  },
  {
   "do": "request",
   "permission": "@agent",
   "agent": "shopping-agent",
   "amount": 12000,
   "merchant_alias": "Online Shop",
   "purpose": "Desk lamp",
   "expect": "HOLD",
   "say": "The agent asks for 120.00: over its delegation"
  },
  {
   "do": "request",
   "permission": "@agent",
   "agent": "shopping-agent",
   "amount": 4500,
   "merchant_alias": "Online Shop",
   "purpose": "Desk lamp",
   "assessment": {
    "decision": "approve",
    "confidence": 0.97
   },
   "expect": "ALLOW",
   "say": "The agent asks for 45.00 with confidence 0.97: paid"
  },
  {
   "do": "revoke",
   "permission": "paypal_sub:first",
   "say": "Revoke a live sandbox subscription"
  },
  {
   "do": "request",
   "permission": "paypal_sub:revoked",
   "amount": "median",
   "is_recurring": true,
   "expect": "BLOCK",
   "say": "A charge on the revoked permission is blocked"
  }
 ]
}