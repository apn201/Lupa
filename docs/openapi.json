  "components": {
    "schemas": {
      "AgentPermissionIn": {
        "properties": {
          "agent_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Agent Id"
          },
          "label": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Label",
            "description": "what the agent buys, e.g. 'Shopping'"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "marketplace"
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "label"
        ],
        "title": "AgentPermissionIn"
      },
      "Assessment": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "escalate",
              "reject"
            ],
            "title": "Decision"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "confidence"
        ],
        "title": "Assessment"
      },
      "DelegateIn": {
        "properties": {
          "agent_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Agent Id"
          },
          "authority": {
            "type": "string",
            "enum": [
              "propose",
              "approve"
            ],
